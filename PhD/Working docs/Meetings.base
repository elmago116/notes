filters:
  and:
    - file.hasTag("op/activity/meeting")
    - '!file.hasTag("op/level/TFM-FIMA", "CCC")'
views:
  - type: table
    name: Table
    order:
      - file.name
      - date
      - file.tags
      - file.folder
      - authors
    sort:
      - property: date
        direction: DESC
    columnSize:
      file.name: 220
      file.tags: 98
      file.folder: 111
